{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "backend/api/index.js", "use": "@vercel/node" },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "frontend/build/client" }
    }
  ],
  "routes": [
    { "src": "/api(?:/.*)?$", "dest": "/backend/api/index.js" },
    { "src": "/assets/(.*)$", "dest": "/assets/$1" },
    { "src": "/(index|cadastro|nova|resultado|foto|exemplos|historico|evolucao|perfil|recuperar|privacidade)(\\.html)?$", "dest": "/index.html" },
    { "src": "/$", "dest": "/index.html" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
