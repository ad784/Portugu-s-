{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "backend/api/index.js", "use": "@vercel/node" },
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api(?:/.*)?$", "dest": "/backend/api/index.js" },
    { "src": "/", "dest": "/frontend/pages/index.html" },
    { "src": "/(index|cadastro|nova|resultado|foto|exemplos|historico|evolucao|perfil|recuperar|privacidade)(\\.html)?$", "dest": "/frontend/pages/$1.html" },
    { "src": "/styles/(.*)$", "dest": "/frontend/styles/$1" },
    { "src": "/scripts/(.*)$", "dest": "/frontend/scripts/$1" },
    { "src": "/assets/(.*)$", "dest": "/frontend/assets/$1" }
  ]
}
